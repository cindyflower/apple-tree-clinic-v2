# Public site origin for canonical URLs, sitemap, and Open Graph (no trailing slash).
# Base path (/apple-tree-clinic-v2) is added automatically when GITHUB_PAGES=true.
#
# GitHub Pages preview:
#   VITE_SITE_URL=https://cindyflower.github.io
#
# Cloudflare Pages AB Test preview (no GITHUB_PAGES, no custom domain yet):
#   VITE_SITE_URL=https://apple-tree-clinic-v2.pages.dev
#   pnpm run build:production
#
# After AB Test — bind www.drappletree.com.tw:
#   VITE_SITE_URL=https://www.drappletree.com.tw
#   pnpm run build:production
# VITE_SITE_URL=

# Copy to `.env` and fill in values for production analytics.
# Local dev: leave unset — Umami will not load (no console/build warnings).

# Umami instance base URL (no trailing slash), e.g. https://cloud.umami.is
# VITE_ANALYTICS_ENDPOINT=

# Website ID from Umami dashboard
# VITE_ANALYTICS_WEBSITE_ID=
