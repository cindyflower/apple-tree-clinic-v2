# Public site origin for canonical URLs, sitemap, and Open Graph (no trailing slash).
# Base path (/apple-tree-clinic-v2) is added automatically when GITHUB_PAGES=true.
#
# GitHub Pages preview:
#   VITE_SITE_URL=https://cindyflower.github.io
#
# Cloudflare Pages AB Test preview (no GITHUB_PAGES, no custom domain yet):
#   VITE_SITE_URL=https://apple-tree-clinic-v2.pages.dev
#   pnpm run build:production
#
# After AB Test — bind www.drappletree.com.tw:
#   VITE_SITE_URL=https://www.drappletree.com.tw
#   pnpm run build:production
# VITE_SITE_URL=

# Copy to `.env` and fill in values for production analytics.
# Local dev: leave unset — Umami will not load (no console/build warnings).

# Umami instance base URL (no trailing slash), e.g. https://cloud.umami.is
# VITE_ANALYTICS_ENDPOINT=

# Website ID from Umami dashboard
# VITE_ANALYTICS_WEBSITE_ID=

# Marketing tags. Preferred: configure one GTM container and manage GA4,
# Google Ads, Meta Pixel, and LINE Tag inside GTM to avoid duplicate events.
# Production tags load on page view; keep the public site free of extra consent UI.
# VITE_GTM_CONTAINER_ID=GTM-PHSH4JH4
#
# Direct-tag fallback only when GTM is unset (Meta Pixel still injects even if GTM is set):
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_GOOGLE_ADS_ID=AW-XXXXXXXXX
# VITE_META_PIXEL_ID=1711029540139618
# VITE_LINE_TAG_ID=

# Optional same-origin lead API path. Only the canonical /api/leads path is accepted;
# external URLs, credentials, query strings, and fragments are rejected.
# Until configured, the form directs visitors to the working LINE/phone paths.
# VITE_LEAD_WEBHOOK_URL=/api/leads
